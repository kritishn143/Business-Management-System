# Copy this file to .env.local and fill in your own Supabase project's values.
# Never commit .env or .env.local — they are gitignored on purpose.

# Public — safe to ship to the browser (see src/lib/env.ts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Older Supabase projects may instead use:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — used for local migrations/tooling. Never expose to the browser,
# never put in Vercel unless a server-only feature genuinely needs it (SPEC §53/85).
# SUPABASE_DB_PASSWORD=
# SUPABASE_SERVICE_ROLE_KEY=
